# Copy this file to .env (and .env.production for a prod build) and adjust as needed.
# Vite only exposes variables prefixed with VITE_ to the browser bundle - anything here ends up
# readable in the shipped JS, so this file is for PUBLIC config only (API endpoints, public keys
# for third-party widgets, feature flags). Never put real secrets (DB passwords, JWT signing keys,
# private API keys) here - those belong only in backend/.env, which never reaches the browser.

# Origin the local dev server's /api proxy forwards requests to (see vite.config.js).
# Change this if the backend's dev port ever changes - nothing else needs editing.
VITE_BACKEND_ORIGIN=http://localhost:5050

# Full API base URL the app itself calls. Leave unset in dev - requests go to the relative path
# "/api/v1" on this same origin, which the dev proxy above forwards to VITE_BACKEND_ORIGIN.
# Set this explicitly for a production build if the app and API are served from different origins,
# e.g. VITE_API_BASE_URL=https://api.tiveni.example.com/api/v1
# VITE_API_BASE_URL=
