{
  "name": "tiveni-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "bin": "src/server.js",
  "scripts": {
    "dev": "supervisor src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seeds/seed.js",
    "build:exe": "node --experimental-require-module ./node_modules/@yao-pkg/pkg/lib-es5/bin.js . --targets node20-win-x64 --output dist/triveni-backend.exe"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mkdirp": "^3.0.1",
    "mqtt": "^5.15.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "nodemailer": "^10.0.3",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.3",
    "supervisor": "^0.12.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.14.2",
    "nodemon": "^3.1.0"
  },
  "pkg": {
    "scripts": [
      "node_modules/pdfkit/js/**/*.js"
    ],
    "assets": [
      "src/db/migrations/**/*"
    ],
    "outputPath": "dist"
  }
}
