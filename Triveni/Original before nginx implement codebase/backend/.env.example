# Server
NODE_ENV=development
PORT=5050
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Existing MariaDB server connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tiveni_production_planning
DB_USER=tiveni_app
DB_PASSWORD=change_me
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_too_to_a_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Default seeded admin (seed script only, change password after first login)
SEED_ADMIN_EMAIL=admin@tiveni.local
SEED_ADMIN_PASSWORD=Admin@12345

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# External Coil Lookup API (optional) - powers the "Get Coil Info" button in the operator app's
# Coil Info dialog. Leave COIL_LOOKUP_API_URL blank to disable the feature (operators will just
# see a message to enter details manually). Expected to be a GET endpoint accepting a coilNo
# query param and returning JSON with grade/coil size/coil weight fields - see
# backend/src/services/coilLookup.service.js for the exact field-name mapping, which can be
# adjusted once the real vendor/ERP API contract is confirmed.
COIL_LOOKUP_API_URL=
COIL_LOOKUP_API_KEY=
COIL_LOOKUP_API_TIMEOUT_MS=8000

# MQTT (optional) - receives live Produced Qty readings from machines and updates the matching
# RUNNING machine_planning row (matched by Device_ID+Slave_ID against machines.device_id/slave_id).
# Leave MQTT_BROKER_URL blank to disable the feature entirely (the app just skips connecting).
# See backend/src/services/mqttProduction.service.js for the expected message JSON shape.
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=
MQTT_PRODUCTION_TOPIC=tiveni/production
MQTT_QOS=1
MQTT_RECONNECT_PERIOD_MS=5000

# Frontend URL (optional) - used to build the reset-password link sent by "Forgot Password".
# Falls back to CORS_ORIGIN if left blank, so this only needs setting if the two ever differ.
FRONTEND_URL=http://localhost:5173

# SMTP (optional) - powers the "Forgot Password" email. Leave SMTP_HOST blank to disable actually
# sending mail; the reset link is logged instead (and, outside production, returned directly in
# the API response - see auth.service.js#forgotPassword) so the flow is still testable without a
# mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Triveni Steel ERP <no-reply@triveni.local>
